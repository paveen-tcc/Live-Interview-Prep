# Copy to .env for local development. .env and .env.local are gitignored.
# Production values live in Zerops environment variables, not in this file.

APP_ENV=local
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# Local default: a SQLite file under data/, created on first boot.
DATABASE_URL=sqlite+aiosqlite:///./data/interview_coach.db
DATABASE_CONNECT_TIMEOUT_SECONDS=10
AUTO_CREATE_SCHEMA=true
#
# Supabase (used in staging/production). Take the URI from
# Project Settings -> Database -> Connection string, SESSION pooler tab:
#   postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Note the username is postgres.PROJECTREF for the pooler, not plain postgres.
# Port 6543 is the transaction pooler; the app disables prepared statements
# automatically when it sees that port, but session mode is the simpler default.
# The direct db.PROJECTREF.supabase.co endpoint is IPv6-only, so avoid it.
# sslmode/channel_binding query parameters are stripped automatically because
# asyncpg does not accept them. Supabase presents a certificate from its own
# private CA, so TLS is verified against server/certs/supabase-prod-ca-2021.crt
# rather than certifi. Override that only if Supabase rotates the root:
# DATABASE_SSL_ROOT_CERT=/path/to/prod-ca.crt

# --- Authentication -----------------------------------------------------
# local: every request is the single developer identity below. No sign-in.
# clerk: requests must carry a Clerk session token.
AUTH_MODE=local
LOCAL_AUTH_SUBJECT=local-developer
LOCAL_AUTH_EMAIL=developer@local.test
LOCAL_AUTH_NAME=Local developer
#
# Required when AUTH_MODE=clerk.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# PEM public key from Clerk -> Configure -> API keys. Optional but recommended:
# with it set, token verification never makes a network call.
# CLERK_JWT_KEY=
# Comma-separated origins allowed to mint tokens, e.g. https://app.zerops.app
# CLERK_AUTHORIZED_PARTIES=
# Only needed for a Clerk production instance on a custom domain. Development
# instances are matched by the default *.clerk.accounts.dev CSP entry.
# CLERK_FRONTEND_API_URL=
#
# The web build reads this separately (Vite inlines VITE_ variables at build
# time). Set it in web/.env.local for local Clerk testing.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

WEB_DIST_DIR=web/dist

# Local-only quiet-room workflow. Keep false in production unless intentionally enabled.
ENABLE_TEXT_DEV_MODE=true
TYPED_ANSWER_MAX_CHARACTERS=20000
REALTIME_CLIENT_SECRET_TTL_SECONDS=120
REALTIME_CLIENT_SECRET_RATE_LIMIT=6
REALTIME_RECONNECT_WINDOW_SECONDS=180
DAILY_INTERVIEW_QUOTA=10
DAILY_EVALUATION_QUOTA=20
TRANSCRIPT_RETENTION_DAYS=30
DRAFT_RETENTION_DAYS=30
DELIVERY_METRICS_RETENTION_DAYS=30
USAGE_EVENT_RETENTION_DAYS=90
RESUME_MAX_BYTES=5000000
RESUME_MAX_PAGES=10
RESUME_MAX_EXTRACTED_CHARACTERS=200000
RESUME_MAX_DOCX_ENTRIES=500
RESUME_MAX_DOCX_UNCOMPRESSED_BYTES=20000000
RESUME_EXTRACTION_TIMEOUT_SECONDS=8

# auto uses one structured-output call when the Azure values are configured.
# rules is the deterministic fallback; llm requires Azure configuration.
PROFILE_EXTRACTION_MODE=auto
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TEXT_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_OPENAI_REALTIME_VOICE=alloy
AZURE_OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
AZURE_OPENAI_FINAL_TRANSCRIPTION_DEPLOYMENT=gpt-4o-transcribe
AZURE_OPENAI_TRANSCRIPTION_LANGUAGE=en
AZURE_OPENAI_TRANSCRIPTION_DELAY=low
AZURE_OPENAI_TRANSCRIPTION_API_VERSION=2024-06-01
AZURE_OPENAI_REALTIME_TIMEOUT_SECONDS=20
AZURE_OPENAI_FINAL_TRANSCRIPTION_TIMEOUT_SECONDS=30
AZURE_OPENAI_FINAL_TRANSCRIPTION_MAX_BYTES=25000000
RESUME_LLM_TIMEOUT_SECONDS=45
RESUME_LLM_MAX_INPUT_CHARACTERS=80000
EVALUATION_LLM_TIMEOUT_SECONDS=90
EVALUATION_MAX_TRANSCRIPT_CHARACTERS=160000
